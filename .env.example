# Services reached only by the Next.js server. Do not use NEXT_PUBLIC_ prefixes.
PDF_MICROSERVICE_URL=http://127.0.0.1:5000
DIAGRAM_SERVICE_URL=http://127.0.0.1:5010

# Browser-facing backend URL used by existing tools.
NEXT_PUBLIC_PDF_MICROSERVICE_URL=http://127.0.0.1:5000

# PDF editor safety features. Structural text editing fails closed when the
# microservice is unavailable; it never exports a visual-only replacement.
NEXT_PUBLIC_PDF_EDITOR_SERVER_TEXT_EDIT=true
NEXT_PUBLIC_PDF_EDITOR_TEXT_SHAPING_GUARD=true

# Optional direct renderer fallbacks. The dedicated diagram service is preferred.
KROKI_SERVER_URL=
PLANTUML_SERVER_URL=
WSD_ENDPOINT=https://www.websequencediagrams.com/index.php
WSD_API_KEY=

DIAGRAM_RENDER_TIMEOUT_MS=15000
DIAGRAM_MAX_SOURCE_BYTES=200000
DIAGRAM_MAX_OUTPUT_BYTES=4000000

# Browser-facing Supabase Auth. Copy both values from the project's
# Settings â†’ API page (Project URL + publishable key). These are public values,
# but they must point at the project this deployment actually uses: a stale or
# deleted project ref fails at DNS level, and the sign-in form can only report
# that the auth service could not be reached.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Contact form (EmailJS). Public values used in the browser; keep them here
# rather than hardcoded. Unset EmailJS values make the form point visitors at
# NEXT_PUBLIC_CONTACT_EMAIL instead of failing silently.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_CONTACT_EMAIL=mycloove26@gmail.com

# Shared secret between Next.js (and the Go job worker) and Flask.
# When set, a copied curl to :5001 is refused. Do not prefix with NEXT_PUBLIC_.
PDF_SERVICE_INTERNAL_KEY=<random-shared-secret>

# Optional key-encryption key (KEK) for AI provider keys. The bench at /admin/ai
# encrypts each provider key under a data key (DEK) stored in the `system_secrets`
# table, so keys travel with the database and open on ANY server pointed at the
# same DATABASE_URL â€” no machine-local secret required. When this is set at first
# setup it is adopted as the DEK (so existing rows keep opening) and stored wrapped
# by it; it must then be byte-identical in every environment that reads those keys,
# or they are locked. When it is left unset, a random DEK is generated and stored
# unwrapped â€” the portable default. Must decode to exactly 32 bytes when set:
# generate one with `openssl rand -base64 32`.
AI_KEY_ENCRYPTION_SECRET=

# Legacy AI keys. Used only when the bench has no usable provider chain, so
# these remain the rollback story. Once keys are managed at /admin/ai they can
# be removed from the environment.
# GROQ_API_KEY=
# HF_TOKEN=

# â”€â”€ GitHub integration (Mr. Markdown â†’ Connections) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# A GitHub App (not an OAuth App and not a PAT) gives per-repository access the
# owner controls: they install it on "Only select repositories" and grant
# Contents: Read & write + Metadata: Read-only. Reads are browse/verify; writes
# happen only when the owner confirms a publish (commit or pull request).
# Server-only; never NEXT_PUBLIC_. When ALL of these are absent the feature is
# honestly gated to "Soon" and the Connections section shows no Connect button.
#
# Register the App at https://github.com/settings/apps with:
#   Setup URL  = https://<host>/api/integrations/github/callback
#   Webhook    = https://<host>/api/integrations/github/webhook  (Phase 3)
#   Permissions        = Contents: Read & write, Metadata: Read-only
#   Where can it be installed = Only on this account (or any account for orgs)
# Changing Contents from read-only to Read & write later requires the owner to
# approve the new permission on GitHub, then reconnect in Mr. Markdown.
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_CLIENT_ID=your-github-app-client-id
GITHUB_APP_CLIENT_SECRET=your-github-app-client-secret
GITHUB_APP_SLUG=mycloove
# The App private key. Base64-encode the .pem so it survives a .env / Compose
# value: `base64 -w0 private-key.pem` (or `openssl base64 -A -in private-key.pem`).
# A literal PEM with \n escapes is also accepted.
GITHUB_APP_PRIVATE_KEY=your-base64-or-escaped-pem-private-key
# Only needed once the webhook route is wired (Phase 3). Signs each delivery;
# the route rejects any body whose X-Hub-Signature-256 does not match.
GITHUB_WEBHOOK_SECRET=

# Supabase database URLs. Do not prefix with NEXT_PUBLIC_.
# DATABASE_URL is the runtime connection (the pooler URL is fine).
# DIRECT_URL is the direct connection Prisma Migrate uses. When it is empty,
# migrate falls back to DATABASE_URL.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres"
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
