{
  "name": "nextjs-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prisma.mjs generate && next dev",
    "build": "node scripts/prisma.mjs generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test:pdf-editor": "node --experimental-strip-types --test app/pdf-editor/pdfEdit-utils/*.test.ts",
    "pdf-editor:unit": "npm run test:pdf-editor",
    "test:pdf-tools": "node --experimental-strip-types --test lib/pdf/*.test.ts features/merge-pdf/server/*.test.ts features/merge-pdf/components/parts/*.test.ts features/split-pdf/server/*.test.ts features/rotate-pdf/server/*.test.ts features/compress-pdf/server/*.test.ts",
    "test:mr-markdown": "node --experimental-strip-types --test components/PDFToMarkdown/merge/*.test.ts components/PDFToMarkdown/utils.test.ts components/PDFToMarkdown/settings/connections/*.test.ts",
    "mr-markdown:unit": "npm run test:mr-markdown",
    "test:ai": "node --experimental-strip-types --test lib/ai/*.test.ts",
    "test:integrations": "node --experimental-strip-types --test lib/integrations/*.test.ts lib/integrations/github/*.test.ts",
    "pdf-editor:fixtures": "node --experimental-strip-types tests/pdf-editor/generate-golden-corpus.ts",
    "pdf-editor:e2e": "playwright test --config playwright.config.ts",
    "pdf-editor:e2e:update": "playwright test --config playwright.config.ts --update-snapshots",
    "pdf-editor:verify": "npm run pdf-editor:fixtures && npm run pdf-editor:unit && npm run typecheck && npm run pdf-editor:e2e",
    "test:pdf-editor:e2e": "npm run pdf-editor:e2e",
    "test:pdf-editor:gate": "npm run pdf-editor:verify",
    "typecheck": "node scripts/prisma.mjs generate && tsc --noEmit",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:migrate": "node scripts/prisma.mjs migrate dev",
    "db:studio": "node scripts/prisma.mjs studio"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@viz-js/viz": "^3.29.0",
    "dompurify": "^3.4.13",
    "fabric": "^5.5.2",
    "highlight.js": "11.11.1",
    "jiti": "^2.6.1",
    "jszip": "^3.10.1",
    "katex": "0.18.0",
    "mermaid": "11.16.0",
    "next": "16.2.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.6.205",
    "pg": "^8.23.0",
    "plotly.js-dist-min": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^15.0.0",
    "regenerator-runtime": "^0.14.1",
    "sharp": "^0.34.5",
    "vega": "^6.3.1",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.3",
    "wavedrom": "^3.6.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@prisma/dev": "^0.25.2",
    "@tailwindcss/postcss": "^4",
    "@types/fabric": "^5.3.11",
    "@types/node": "^20.19.37",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
